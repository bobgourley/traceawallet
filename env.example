# Copy of the variables Railway needs. Real values live in Railway, never in this repo.
DATABASE_URL=
SERVICE_ROLE=web            # web or worker
BUCKET_ENDPOINT=
BUCKET_NAME=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
BUCKET_REGION=auto          # optional; most S3-compatible buckets accept auto
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
BLOCKSCOUT_API_KEY=         # EVM chains (worker); from dev.blockscout.com
ETHERSCAN_API_KEY=          # tests and cross-checks only
TRONGRID_API_KEY=
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
HASH_SALT=
APP_BASE_URL=https://traceawallet.com
# Invite-only: the email addresses allowed to use the site, separated by commas.
TESTER_EMAILS=
# Optional: Clerk's PEM public key (Clerk Dashboard, API keys), for checking sign-in
# without a network call. Without it the key is fetched with CLERK_SECRET_KEY.
CLERK_JWT_KEY=
# Optional: where the web pages reach the API. Default http://127.0.0.1:$PORT.
TAW_API_URL=
